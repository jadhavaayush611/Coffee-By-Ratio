---
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import BrewTimer from '../../components/BrewTimer';

import RelatedResources from '../../components/RelatedResources.astro';

const v60Steps = [
  {
    title: 'Bloom',
    duration: 45,
    description: 'Pour 50g of water. Gently stir to ensure all grounds are wet. Wait for CO2 to escape.',
    targetWater: 50
  },
  {
    title: 'First Pour',
    duration: 60,
    description: 'Pour water in circular motions up to 150g. Keep the stream steady.',
    targetWater: 150
  },
  {
    title: 'Second Pour',
    duration: 45,
    description: 'Pour remaining water up to 250g. Gently swirl the brewer for a flat bed.',
    targetWater: 250
  },
  {
    title: 'Drawdown',
    duration: 60,
    description: 'Let the water filter through completely. Aim for a total time of 3:00 - 3:30.',
  }
];
---

<Layout title="Hario V60 Guide" description="Step-by-step Hario V60 brewing guide with interactive timer and precision ratios.">
  <Container as="div" class="py-12 md:py-24 w-full">
    <div class="flex flex-col md:flex-row gap-12 items-start mb-16">
      <div class="flex-grow">
        <nav class="flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-muted mb-6">
          <a href="/guides" class="hover:text-foreground">Guides</a>
          <span>/</span>
          <span class="text-foreground">Hario V60</span>
        </nav>
        <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">Hario V60.</h1>
        <p class="text-lg text-body mb-8 leading-relaxed">
          The Hario V60 is a classic pour-over brewer that rewards precision. 
          Its 60° angle and large exit hole allow for a faster flow, giving you maximum control over extraction and flavor clarity.
        </p>
        <div class="grid grid-cols-3 gap-8 p-6 bg-card border border-border rounded-xl">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-muted block mb-1">Ratio</span>
            <span class="text-lg font-bold">1:16</span>
          </div>
          <div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-muted block mb-1">Grind</span>
            <span class="text-lg font-bold">Medium-Fine</span>
          </div>
          <div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-muted block mb-1">Temp</span>
            <span class="text-lg font-bold">94°C</span>
          </div>
        </div>

        <!-- Tools & Interactive Features Status -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
          <!-- Calculator Availability -->
          <div class="p-6 bg-card border border-border rounded-2xl flex items-start gap-4 shadow-sm hover:shadow-md transition-all">
            <div class="p-2 rounded-lg bg-success/10 text-success shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-mono uppercase tracking-widest text-muted mb-1">Calculator</span>
              <span class="block text-sm font-semibold text-foreground">Calculator Available</span>
              <span class="block text-xs text-body mt-1">Adjust grounds or water weight on this page, or try the <a href="/calculator" class="text-link hover:underline">Ratio Calculator</a>.</span>
            </div>
          </div>

          <!-- Timer Availability -->
          <div class="p-6 bg-card border border-border rounded-2xl flex items-start gap-4 shadow-sm hover:shadow-md transition-all">
            <div class="p-2 rounded-lg bg-success/10 text-success shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-mono uppercase tracking-widest text-muted mb-1">Brew Timer</span>
              <span class="block text-sm font-semibold text-foreground">Brew Timer Available</span>
              <span class="block text-xs text-body mt-1">Interactive step-by-step assistant with audio alerts is enabled below.</span>
            </div>
          </div>

          <!-- Required Brewing Tools -->
          <div class="p-6 bg-card border border-border rounded-2xl flex items-start gap-4 shadow-sm hover:shadow-md transition-all">
            <div class="p-2 rounded-lg bg-warning-soft text-warning-deep shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </div>
            <div class="min-w-0">
              <span class="block text-xs font-mono uppercase tracking-widest text-muted mb-1">Required Tools</span>
              <span class="block text-sm font-semibold text-foreground truncate">Hario V60, Filter Paper, Kettle</span>
              <span class="block text-xs text-body mt-1">Equipment needed: Hario V60 Dripper, V60 Paper Filter, Gooseneck Kettle, Digital Scale, Timer</span>
            </div>
          </div>
        </div>
      </div>
      <div class="w-full md:w-1/3 aspect-square bg-cyan/10 rounded-2xl flex items-center justify-center text-cyan border border-cyan/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8h1a4 4 0 1 1 0 8h-1"/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z"/><line x1="6" x2="14" y1="2" y2="2"/></svg>
      </div>
    </div>

    <div class="space-y-12">
      <BrewTimer 
        client:load 
        steps={v60Steps} 
        totalCoffee={15} 
        title="Interactive Brew Assistant"
        description="Adjust your coffee weight and the timer will guide you through each pour." 
      />

      <div class="grid md:grid-cols-2 gap-12 mt-24">
        <div>
          <h3 class="text-xl font-bold mb-4">Preparation</h3>
          <ul class="space-y-4">
            <li class="flex gap-4">
              <span class="text-link font-bold">01.</span>
              <p class="text-sm text-body"><strong class="text-foreground">Rinse Filter:</strong> Place the filter in the V60 and rinse with hot water to remove paper taste and preheat the brewer.</p>
            </li>
            <li class="flex gap-4">
              <span class="text-link font-bold">02.</span>
              <p class="text-sm text-body"><strong class="text-foreground">Grind Coffee:</strong> Grind 15g of coffee to a medium-fine consistency (think table salt).</p>
            </li>
            <li class="flex gap-4">
              <span class="text-link font-bold">03.</span>
              <p class="text-sm text-body"><strong class="text-foreground">Level Grounds:</strong> Add coffee to the V60 and give it a gentle shake to create a flat bed.</p>
            </li>
          </ul>
        </div>
        <div>
          <h3 class="text-xl font-bold mb-4">Tips for Success</h3>
          <div class="p-6 bg-background border border-border rounded-xl space-y-4">
            <p class="text-sm text-body">
              <strong class="text-foreground">The Bloom:</strong> Don't skip this! It releases CO2 trapped in the beans, allowing water to extract flavor more effectively.
            </p>
            <p class="text-sm text-body">
              <strong class="text-foreground">Circular Pours:</strong> Pour in consistent, small circles to ensure even extraction. Avoid pouring directly against the sides.
            </p>
            <p class="text-sm text-body">
              <strong class="text-foreground">Flow Rate:</strong> If your drawdown is taking too long (>4:00), try a coarser grind next time.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-24 min-w-0">
      <RelatedResources 
        brewMethod="v60" 
        excludeId="v60-ratio-calculator" 
        title="Explore More V60 Resources"
      />
    </div>
  </Container>
</Layout>
