---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Container from '../../components/Container.astro';
import FAQ from '../../components/FAQ.astro';
import HowToSchema from '../../components/schemas/HowToSchema.astro';
import BreadcrumbSchema from '../../components/schemas/BreadcrumbSchema.astro';
import RelatedResources from '../../components/RelatedResources.astro';
import { guideSchemaData } from '../../data/guide-data';
import BrewTimer from '../../components/BrewTimer';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map(guide => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);

const extraData = guideSchemaData[guide.id];

const breadcrumbs = [
  { name: 'Home', item: 'https://coffeebyratio.com' },
  { name: 'Guides', item: 'https://coffeebyratio.com/guides' },
  { name: guide.data.title, item: `https://coffeebyratio.com/guides/${guide.id}` }
];

// Map brew methods to relevant FAQ slugs
const methodFaqs: Record<string, string[]> = {
  'v60': ['1-15-vs-1-17-pour-over', 'best-ratio-for-iced-pour-over', 'filter-type-affect-ratio', 'bloom-water-in-ratio', 'sca-standard-coffee-ratio', 'kalita-wave-ratio', 'origami-dripper-ratio'],
  'french-press': ['french-press-ratio', '32-oz-french-press-ratio', 'cold-brew-french-press-ratio', 'filter-type-affect-ratio', 'weight-vs-volume-coffee'],
  'aeropress': ['aeropress-ratio-best', 'inverted-aeropress-ratio', '1-10-coffee-ratio-use', 'weight-vs-volume-coffee', 'perfect-ratio-milk-drinks'],
  'chemex': ['chemex-ratio', 'best-ratio-for-iced-pour-over', 'filter-type-affect-ratio', '1-15-vs-1-17-pour-over', 'bloom-water-in-ratio'],
  'cold-brew': ['cold-brew-high-ratio', 'cold-brew-french-press-ratio', '1-10-coffee-ratio-use', '1-1-ratio-coffee-concentrate', 'coffee-soda-ratio'],
  'espresso': ['standard-espresso-ratio', 'espresso-1-2-ratio-calculation', 'ristretto-vs-lungo-ratio', 'perfect-ratio-milk-drinks', 'grind-size-affect-ratio']
};

const relevantFaqs = methodFaqs[guide.data.brewMethod as string] || [];
---

<Layout title={guide.data.title} description={guide.data.description}>
  <BreadcrumbSchema items={breadcrumbs} />
  {extraData && (
    <HowToSchema 
      name={guide.data.title}
      description={guide.data.description}
      totalTime={extraData.totalTime}
      supply={extraData.supply}
      tool={extraData.tool}
      steps={extraData.steps}
    />
  )}
  <Container as="article" class="py-24 w-full">
    <div class="mb-16 w-full">
      <div class="flex items-center gap-4 mb-8">
        <span class="px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider">
          {guide.data.brewMethod}
        </span>
        <span class="text-muted text-sm">•</span>
        <span class="text-muted text-sm font-medium">{guide.data.difficulty}</span>
      </div>
      <h1 class="mb-8 tracking-tight">
        {guide.data.title}
      </h1>
      <p class="text-xl text-body leading-relaxed mb-12 w-full">
        {guide.data.description}
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 p-8 md:p-10 bg-card border border-border rounded-2xl shadow-lg w-full min-w-0">
        <div class="flex flex-col min-w-0">
          <span class="text-[10px] font-mono uppercase tracking-widest text-muted mb-2">Ratio</span>
          <span class="text-xl font-bold truncate">{guide.data.ratio}</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[10px] font-mono uppercase tracking-widest text-muted mb-2">Prep Time</span>
          <span class="text-xl font-bold truncate">{guide.data.prepTime}</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[10px] font-mono uppercase tracking-widest text-muted mb-2">Brew Time</span>
          <span class="text-xl font-bold truncate">{guide.data.brewTime}</span>
        </div>
        <div class="flex flex-col min-w-0">
          <span class="text-[10px] font-mono uppercase tracking-widest text-muted mb-2">Method</span>
          <span class="text-xl font-bold uppercase truncate">{guide.data.brewMethod}</span>
        </div>
      </div>

      <!-- Tools & Interactive Features Status -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
        <!-- Calculator Availability -->
        <div class="p-6 bg-card border border-border rounded-2xl flex items-start gap-4 shadow-sm hover:shadow-md transition-all">
          <div class="p-2 rounded-lg bg-success/10 text-success shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-mono uppercase tracking-widest text-muted mb-1">Calculator</span>
            <span class="block text-sm font-semibold text-foreground">Calculator Available</span>
            <span class="block text-xs text-body mt-1">Adjust grounds or water weight on this page, or try the <a href="/calculator" class="text-link hover:underline">Ratio Calculator</a>.</span>
          </div>
        </div>

        <!-- Timer Availability -->
        <div class="p-6 bg-card border border-border rounded-2xl flex items-start gap-4 shadow-sm hover:shadow-md transition-all">
          {['v60', 'chemex', 'aeropress', 'french-press'].includes(guide.data.brewMethod) ? (
            <>
              <div class="p-2 rounded-lg bg-success/10 text-success shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </div>
              <div class="min-w-0">
                <span class="block text-xs font-mono uppercase tracking-widest text-muted mb-1">Brew Timer</span>
                <span class="block text-sm font-semibold text-foreground">Brew Timer Available</span>
                <span class="block text-xs text-body mt-1">Interactive step-by-step assistant with audio alerts is enabled below.</span>
              </div>
            </>
          ) : (
            <>
              <div class="p-2 rounded-lg bg-muted-background text-muted shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="4.93" x2="19.07" y1="4.93" y2="19.07"/></svg>
              </div>
              <div class="min-w-0">
                <span class="block text-xs font-mono uppercase tracking-widest text-muted mb-1">Brew Timer</span>
                <span class="block text-sm font-semibold text-muted">Not Applicable</span>
                <span class="block text-xs text-body mt-1">This immersion style does not require a dynamic step-by-step timer.</span>
              </div>
            </>
          )}
        </div>

        <!-- Related Brewing Tools -->
        <div class="p-6 bg-card border border-border rounded-2xl flex items-start gap-4 shadow-sm hover:shadow-md transition-all">
          <div class="p-2 rounded-lg bg-warning-soft text-warning-deep shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div class="min-w-0">
            <span class="block text-xs font-mono uppercase tracking-widest text-muted mb-1">Required Tools</span>
            <span class="block text-sm font-semibold text-foreground truncate">
              {extraData ? extraData.tool.slice(0, 3).join(', ') + (extraData.tool.length > 3 ? '...' : '') : 'Scale, Grinder, Kettle'}
            </span>
            <span class="block text-xs text-body mt-1">Equipment needed: {extraData ? extraData.tool.join(', ') : 'Standard brewing gear'}</span>
          </div>
        </div>
      </div>
    </div>

    {['v60', 'chemex', 'aeropress', 'french-press'].includes(guide.data.brewMethod) && (
      <div class="my-16 w-full max-w-6xl mx-auto">
        <BrewTimer 
          client:load 
          initialMethodId={guide.data.brewMethod} 
          title="Interactive Brew Assistant"
          description="Adjust your coffee weight and the timer will guide you through each step."
        />
      </div>
    )}

    <div class="prose prose-lg max-w-none w-full prose-headings:font-bold prose-headings:tracking-tight prose-a:text-primary hover:prose-a:opacity-80 transition-all prose-p:text-lg prose-p:leading-8">
      <Content />
    </div>

    {relevantFaqs.length > 0 && (
      <div class="mt-24 pt-12 border-t border-border min-w-0">
        <FAQ title={`${guide.data.title} FAQs`} ids={relevantFaqs} />
      </div>
    )}

    <div class="mt-24 min-w-0">
      <RelatedResources 
        brewMethod={guide.data.brewMethod} 
        excludeId={guide.id} 
        title={`Explore More ${guide.data.brewMethod.toUpperCase()} Resources`}
      />
    </div>
  </Container>
</Layout>


